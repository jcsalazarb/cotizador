def build_placeholders(req: dict, resultado: dict) -> Dict[str, str]:\
    return \{\
        "\{\{COTIZACION_ID\}\}": resultado["cotizacionId"],\
        "\{\{FECHA\}\}": resultado["fecha"][:10],\
        "\{\{NOMBRE\}\}": req["nombre"],\
        "\{\{EMAIL\}\}": req["email"],\
        "\{\{TELEFONO\}\}": req["telefono"],\
        "\{\{CIUDAD\}\}": req["ciudad"],\
        "\{\{DIRECCION\}\}": req["direccion"],\
        "\{\{CONSUMO_MENSUAL\}\}": f"\{req['consumoMensual']:.0f\} kWh",\
        "\{\{VALOR_FACTURA\}\}": f"$\{req['valorFactura']:,.0f\} COP",\
        "\{\{VALOR_KWH\}\}": f"$\{req['valorKwh']:,.0f\} COP",\
        "\{\{TIPO_VIVIENDA\}\}": req["tipoVivienda"],\
        "\{\{SISTEMA_ELECTRICO\}\}": req["sistemaElectrico"],\
        "\{\{TIPO_SISTEMA\}\}": req["tipoSistemaFV"],\
        "\{\{NUM_PANELES\}\}": str(resultado["numeroPaneles"]),\
        "\{\{PANEL_MODELO\}\}": resultado["panel"]["nombre"],\
        "\{\{INVERSORES\}\}": str(resultado["numeroInversores"]),\
        "\{\{INVERSOR_MODELO\}\}": resultado["inversor"]["nombre"],\
        "\{\{CAPACIDAD_INSTALADA_KW\}\}": f"\{resultado['capacidadInstalada']\} kW",\
        "\{\{GENERACION_MENSUAL_KWH\}\}": f"\{resultado['generacionMensual']\} kWh",\
        "\{\{AHORRO_MENSUAL\}\}": f"$\{resultado['ahorroMensualEnergia']:,.0f\} COP",\
        "\{\{RETORNO_ANIOS\}\}": f"\{resultado['tiempoRetorno']\} a\'f1os",\
        "\{\{INVERSION_TOTAL\}\}": f"$\{resultado['valorTotalSistema']:,.0f\} COP",\
        "\{\{PORCENTAJE_PRODUCCION\}\}": f"\{resultado['porcentajeProduccionMensual']\}%",\
        "\{\{SUBTOTAL_SIN_IVA\}\}": f"$\{resultado['subtotalAntesIVA']:,.0f\} COP",\
        "\{\{TOTAL_ACUMULADO_PAYBACK\}\}": f"$\{resultado['TotalAcum']:,.0f\} COP"\
    \}\
\
def replace_shape_text(shape, mapping: Dict[str, str]):\
    if shape.has_text_frame:\
        for p in shape.text_frame.paragraphs:\
            for r in p.runs:\
                for k, v in mapping.items():\
                    if k in r.text:\
                        r.text = r.text.replace(k, v)\
    if shape.has_table:\
        for row in shape.table.rows:\
            for cell in row.cells:\
                for k, v in mapping.items():\
                    if k in cell.text:\
                        cell.text = cell.text.replace(k, v)\
\
def fill_template_and_convert(req: dict, resultado: dict) -> (str, str):\
    if not os.path.isfile(TEMPLATE_PPTX):\
        raise RuntimeError("Template PPTX no encontrado")\
    fd_temp, filled_path = tempfile.mkstemp(suffix=".pptx")\
    os.close(fd_temp)\
    shutil.copy(TEMPLATE_PPTX, filled_path)\
\
    prs = Presentation(filled_path)\
    mapping = build_placeholders(req, resultado)\
    for slide in prs.slides:\
        for shape in slide.shapes:\
            replace_shape_text(shape, mapping)\
    prs.save(filled_path)\
\
    libreoffice_bin = os.getenv("LIBREOFFICE_PATH", "soffice")\
    out_dir = tempfile.mkdtemp()\
    cmd = [\
        libreoffice_bin,\
        "--headless",\
        "--norestore",\
        "--invisible",\
        "--convert-to", "pdf",\
        "--outdir", out_dir,\
        filled_path\
    ]\
    proc = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=90)\
    if proc.returncode != 0:\
        raise RuntimeError(f"LibreOffice error: \{proc.stderr.decode('utf-8')\}")\
    pdf_name = os.path.splitext(os.path.basename(filled_path))[0] + ".pdf"\
    pdf_path = os.path.join(out_dir, pdf_name)\
    if not os.path.isfile(pdf_path):\
        raise RuntimeError("Conversi\'f3n a PDF fallida")\
    return filled_path, pdf_path\
\
# ---------------- EMAIL ----------------\
def enviar_email(destino: str, pdf_path: str, resultado: dict, pptx_path: Optional[str]):\
    SMTP_HOST = os.getenv("SMTP_HOST")\
    SMTP_PORT = int(os.getenv("SMTP_PORT", "587"))\
    SMTP_USER = os.getenv("SMTP_USER")\
    SMTP_PASS = os.getenv("SMTP_PASS")\
    EMAIL_FROM = os.getenv("EMAIL_FROM", SMTP_USER)\
    EMAIL_NASSA = os.getenv("EMAIL_NASSA", EMAIL_FROM)\
\
    if not all([SMTP_HOST, SMTP_USER, SMTP_PASS, destino]):\
        raise RuntimeError("SMTP incompleto")\
\
    msg = EmailMessage()\
    msg["Subject"] = f"Cotizaci\'f3n NASSA Solar - \{resultado['cotizacionId']\}"\
    msg["From"] = EMAIL_FROM\
    msg["To"] = destino\
    msg["Cc"] = EMAIL_NASSA\
\
    cuerpo = f"""\
Estimado \{destino\},\
\
Adjuntamos su cotizaci\'f3n:\
\
ID: \{resultado['cotizacionId']\}\
Inversi\'f3n: $\{resultado['valorTotalSistema']:,.0f\} COP\
Ahorro mensual estimado: $\{resultado['ahorroMensualEnergia']:,.0f\} COP\
Retorno estimado: \{resultado['tiempoRetorno']\} a\'f1os\
Capacidad instalada: \{resultado['capacidadInstalada']\} kW\
\
Saludos,\
NASSA SOLAR\
"""\
    msg.set_content(cuerpo.strip())\
\
    with open(pdf_path, "rb") as f:\
        msg.add_attachment(f.read(), maintype="application", subtype="pdf",\
                           filename=f"Cotizacion_\{resultado['cotizacionId']\}.pdf")\
    if pptx_path and os.path.isfile(pptx_path):\
        with open(pptx_path, "rb") as f:\
            msg.add_attachment(\
                f.read(),\
                maintype="application",\
                subtype="vnd.openxmlformats-officedocument.presentationml.presentation",\
                filename=f"Plantilla_\{resultado['cotizacionId']\}.pptx"\
            )\
\
    with smtplib.SMTP(SMTP_HOST, SMTP_PORT, timeout=60) as server:\
        server.starttls()\
        server.login(SMTP_USER, SMTP_PASS)\
        server.send_message(msg)\
\
