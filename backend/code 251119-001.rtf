@app.post("/api/cotizar", tags=["Cotizaci\'f3n"])\
async def cotizar(request: Request, req: CotizarRequest, _: Any = Depends(rate_limit)):\
    equipos = load_json(EQUIPOS_FILE)\
    ciudades = load_json(CIUDADES_FILE)\
    try:\
        resultado = calcular_cotizacion(req.dict(), equipos, ciudades)\
    except ValueError as e:\
        raise HTTPException(400, str(e))\
    except Exception as e:\
        raise HTTPException(500, f"Error c\'e1lculo: \{e\}")\
\
    pptx_path = pdf_path = None\
    try:\
        pptx_path, pdf_path = fill_template_and_convert(req.dict(), resultado)\
        try:\
            enviar_email(req.email, pdf_path, resultado, pptx_path)\
        except Exception as e:\
            print(f"Error email: \{e\}")\
        finally:\
            for f in (pptx_path, pdf_path):\
                if f and os.path.exists(f):\
                    os.remove(f)\
    except Exception as e:\
        print(f"Error plantilla/PDF: \{e\}")\
\
    resumen = \{\
        "cotizacionId": resultado["cotizacionId"],\
        "fecha": resultado["fecha"],\
        "capacidadInstalada": resultado["capacidadInstalada"],\
        "generacionMensual": resultado["generacionMensual"],\
        "valorTotalSistema": resultado["valorTotalSistema"],\
        "ahorroMensualEnergia": resultado["ahorroMensualEnergia"],\
        "tiempoRetorno": resultado["tiempoRetorno"],\
        "totalAcumuladoPayback": resultado["TotalAcum"],\
        "tablaAhorros": resultado["tablaAhorros"][:10]\
    \}\
    return JSONResponse(\{"status": "success", "mensaje": "Cotizaci\'f3n generada", "resumen": resumen\})\
