# SMTP Namecheap Private Email
SMTP_HOST=mail.privateemail.com
SMTP_PORT=587
SMTP_USER=comercial@nassasolar.com
SMTP_PASS=tu_contraseña_aqui
EMAIL_FROM=comercial@nassasolar.com
EMAIL_NASSA=nassasolar.comercial@outlook.com
EMAIL_SUBJECT=PreCotización Nassa Solar

# Seguridad
ADMIN_USER=admin
ADMIN_PASS=tu_password_seguro_aqui
SECRET_KEY=genera_una_clave_secreta_aqui

# CORS (dominios permitidos, separados por coma)
ALLOWED_ORIGINS=https://tu-dominio.railway.app,https://nassasolar.com

# Servidor (Railway usa variable $PORT automáticamente)
PORT=8001

# LibreOffice (Railway instala automáticamente con nixpacks.toml)
LIBREOFFICE_PATH=soffice

# Rate limiting
RATE_LIMIT=10
